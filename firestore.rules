rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------
    // Helper functions
    // ----------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEventOwner(eventId) {
      let ev = get(/databases/$(database)/documents/events/$(eventId));
      return isAuthenticated() && ev.data.ownerId == request.auth.uid;
    }

    function isEventMember(eventId) {
      let ev = get(/databases/$(database)/documents/events/$(eventId));
      return isAuthenticated() && (
        ev.data.ownerId == request.auth.uid ||
        (ev.data.collaborators is list && request.auth.uid in ev.data.collaborators)
      );
    }

    // ----------------------------------------------------------------
    // Users — only the user can read/update their own profile
    // ----------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string;
      allow update: if isOwner(userId)
        // Prevent overwriting ownership-level fields
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow delete: if false; // Hard-delete handled by Cloud Function
    }

    // ----------------------------------------------------------------
    // Events — private by default; public event pages use /public_events sub-collection
    // ----------------------------------------------------------------
    match /events/{eventId} {
      // Only owner or collaborators can read private event data
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.collaborators is list && request.auth.uid in resource.data.collaborators) ||
        resource.data.isPublic == true
      );
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId is string;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.collaborators is list && request.auth.uid in resource.data.collaborators)
      )
        // Collaborators cannot reassign ownership
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }

    // ----------------------------------------------------------------
    // Tasks — scoped to eventId; only event members can access
    // ----------------------------------------------------------------
    match /tasks/{taskId} {
      allow read: if isAuthenticated()
        && isEventMember(resource.data.eventId);
      allow create: if isAuthenticated()
        && request.resource.data.eventId is string
        && isEventMember(request.resource.data.eventId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated()
        && isEventMember(resource.data.eventId)
        // Prevent changing ownership
        && request.resource.data.eventId == resource.data.eventId;
      allow delete: if isAuthenticated()
        && isEventMember(resource.data.eventId);
    }

    // ----------------------------------------------------------------
    // Expenses — scoped to eventId; only event members can access
    // ----------------------------------------------------------------
    match /expenses/{expenseId} {
      allow read: if isAuthenticated()
        && isEventMember(resource.data.eventId);
      allow create: if isAuthenticated()
        && request.resource.data.eventId is string
        && isEventMember(request.resource.data.eventId)
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;
      allow update: if isAuthenticated()
        && isEventMember(resource.data.eventId)
        && request.resource.data.eventId == resource.data.eventId;
      allow delete: if isAuthenticated()
        && isEventMember(resource.data.eventId);
    }

    // ----------------------------------------------------------------
    // Guests — private RSVP data; only event members can read list
    // Public RSVP submission allowed via eventId + token (see /rsvp collection)
    // ----------------------------------------------------------------
    match /guests/{guestId} {
      allow read: if isAuthenticated()
        && isEventMember(resource.data.eventId);
      allow create: if isAuthenticated()
        && request.resource.data.eventId is string
        && isEventMember(request.resource.data.eventId);
      allow update: if isAuthenticated()
        && isEventMember(resource.data.eventId)
        && request.resource.data.eventId == resource.data.eventId;
      allow delete: if isAuthenticated()
        && isEventOwner(resource.data.eventId);
    }

    // ----------------------------------------------------------------
    // Public RSVP submissions — guest can submit without auth
    // Event owner can read; no update/delete by guests
    // ----------------------------------------------------------------
    match /rsvp/{rsvpId} {
      allow create: if request.resource.data.eventId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200;
      allow read, update, delete: if isAuthenticated()
        && isEventOwner(resource.data.eventId);
    }

    // ----------------------------------------------------------------
    // Saved Vendors — scoped to eventId
    // ----------------------------------------------------------------
    match /vendors/{vendorId} {
      allow read: if isAuthenticated()
        && isEventMember(resource.data.eventId);
      allow create: if isAuthenticated()
        && request.resource.data.eventId is string
        && isEventMember(request.resource.data.eventId);
      allow update, delete: if isAuthenticated()
        && isEventMember(resource.data.eventId);
    }

    // ----------------------------------------------------------------
    // AI Conversations — private to event members
    // ----------------------------------------------------------------
    match /conversations/{convId} {
      allow read: if isAuthenticated()
        && isEventMember(resource.data.eventId);
      allow create: if isAuthenticated()
        && request.resource.data.eventId is string
        && isEventMember(request.resource.data.eventId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // ----------------------------------------------------------------
    // Notifications — private per user
    // ----------------------------------------------------------------
    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // ----------------------------------------------------------------
    // Run Sheets — scoped to event members
    // ----------------------------------------------------------------
    match /runsheets/{sheetId} {
      allow read: if isAuthenticated()
        && isEventMember(resource.data.eventId);
      allow write: if isAuthenticated()
        && isEventMember(resource.data.eventId);
    }

    // ----------------------------------------------------------------
    // Team assignments — scoped to event
    // ----------------------------------------------------------------
    match /team/{memberId} {
      allow read: if isAuthenticated()
        && isEventMember(resource.data.eventId);
      allow write: if isAuthenticated()
        && isEventOwner(resource.data.eventId);
    }

    // ----------------------------------------------------------------
    // Default: deny everything else
    // ----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
