rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------
    // Helper functions
    // ----------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEventMember(eventId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        (
          get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid ||
          (
            get(/databases/$(database)/documents/events/$(eventId)).data.collaborators is list &&
            request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.collaborators
          )
        )
      );
    }

    function isEventOwner(eventId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        (
          get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid
        )
      );
    }

    // ----------------------------------------------------------------
    // Users — profile private to account owner
    // ----------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ----------------------------------------------------------------
    // Events — private by default; public if isPublic == true
    // ----------------------------------------------------------------
    match /events/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.isPublic == true ||
        (resource.data.collaborators is list && request.auth.uid in resource.data.collaborators)
      );
      allow create: if isAuthenticated()
        && (request.resource.data.ownerId == request.auth.uid || request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid || resource.data.createdBy == request.auth.uid);
    }

    // ----------------------------------------------------------------
    // Tasks — scoped to event and user
    // ----------------------------------------------------------------
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isEventMember(resource.data.eventId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        isEventMember(request.resource.data.eventId)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isEventMember(resource.data.eventId)
      );
    }

    // ----------------------------------------------------------------
    // Expenses — scoped to event and user
    // ----------------------------------------------------------------
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isEventMember(resource.data.eventId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        isEventMember(request.resource.data.eventId)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isEventMember(resource.data.eventId)
      );
    }

    // ----------------------------------------------------------------
    // Guests — scoped to event and user
    // ----------------------------------------------------------------
    match /guests/{guestId} {
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isEventMember(resource.data.eventId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        isEventMember(request.resource.data.eventId)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isEventMember(resource.data.eventId)
      );
    }

    // ----------------------------------------------------------------
    // Public RSVP submissions (invited guests)
    // ----------------------------------------------------------------
    match /rsvp/{rsvpId} {
      allow create: if request.resource.data.eventId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow read, update, delete: if isAuthenticated();
    }

    // ----------------------------------------------------------------
    // Vendors
    // ----------------------------------------------------------------
    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ----------------------------------------------------------------
    // Conversations — AI assistant chat history
    // ----------------------------------------------------------------
    match /conversations/{convId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isEventMember(resource.data.eventId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );
    }

    // ----------------------------------------------------------------
    // Notifications — private per user
    // ----------------------------------------------------------------
    match /notifications/{notifId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ----------------------------------------------------------------
    // Run Sheets & Team responsibilities
    // ----------------------------------------------------------------
    match /runsheets/{sheetId} {
      allow read, write: if isAuthenticated();
    }

    match /team/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
